---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/primitives/Container.astro";
import SectionHeader from "../components/primitives/SectionHeader.astro";
import WorkRow from "../components/primitives/WorkRow.astro";
import StatusDot from "../components/primitives/StatusDot.astro";
import MetaLabel from "../components/primitives/MetaLabel.astro";
import ContactSection from "../components/ContactSection.astro";
import JsonLd from "../components/JsonLd.astro";
import { CONTACT } from "../data/contact";
import { ABOUT_INTRO, ABOUT_P1 } from "../data/about";
import { sortExperienceEntries } from "../lib/experience";
import { alumniOfSchema, hasCredentialSchema } from "../data/education";

const allProjects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);
// D-02: Homepage shows exactly 3 featured:true projects (SeatWatch, Multi-Chain EVM Trader, NFL Prediction)
const featured = allProjects.filter((p) => p.data.featured);

// HOME-01: the 01 EXPERIENCE teaser reuses the SAME collection query experience.astro
// uses -- the shared ordering helper + the hasCaseStudy Holloway entry (no data
// duplication, D-05). Do NOT inline a .sort() (experience orders by startDate desc).
// The two guards mirror experience.astro verbatim so the teaser can never point at a
// route the build did not generate (fail loudly if the invariant breaks).
const experienceEntries = sortExperienceEntries(await getCollection("experience"));
const holloway = experienceEntries.find((e) => e.data.hasCaseStudy);
if (!holloway) {
  throw new Error(
    "index.astro: no experience entry has hasCaseStudy: true -- expected the Holloway featured summary for the Home teaser.",
  );
}
if (holloway.id !== "holloway") {
  throw new Error(
    `index.astro: featured entry id "${holloway.id}" != "holloway"; the Home teaser /experience link would point at an unbuilt route.`,
  );
}

// Person schema using CONTACT constants (D-23). The job title + alumniOf +
// hasCredential fields enrich the software-engineer-with-production-experience
// positioning (POS-04, D-14); alumniOf/hasCredential fragments are DERIVED
// in education.ts (24-01) -- no re-hardcoded institution literals here.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Jack Cutrara",
  url: "https://jackcutrara.com",
  jobTitle: "Software Engineer",
  email: CONTACT.email,
  sameAs: [
    CONTACT.github,
    CONTACT.linkedin,
    CONTACT.x,
  ].filter(Boolean),
  alumniOf: alumniOfSchema,
  hasCredential: hasCredentialSchema,
};
---

<BaseLayout title="" description="Software engineer shipping reliable, production-grade systems, currently the solo contract engineer on a live operations platform.">
  <Fragment slot="head">
    <JsonLd schema={personSchema} />
  </Fragment>
  <section class="hero" aria-label="Introduction">
    <Container>
      <div class="hero-grid">
        <div class="hero-content">
          <h1 class="display">
            JACK<br />CUTRARA<span class="accent-dot">.</span>
          </h1>
          <p class="lead hero-lead">
            Software engineer building reliable, production-grade systems.
          </p>
        </div>
        <aside class="hero-meta" aria-label="Status">
          <StatusDot label="AVAILABLE FOR WORK" />
          <MetaLabel text="EST. 2026 · NORTHERN VA" color="ink-muted" />
        </aside>
      </div>
    </Container>
  </section>

  <section class="section experience-teaser" aria-labelledby="section-experience">
    <Container>
      <SectionHeader number="01" title="EXPERIENCE" id="section-experience" />

      {/* HOME-01: compact mirror of experience.astro .featured -- eyebrow / title /
          summary / ONE metric highlight / deep-link. Stack line OMITTED (D-05). */}
      <article class="teaser">
        <p class="meta-mono teaser-eyebrow">
          {holloway.data.role} &middot; {holloway.data.dateRange}
        </p>
        <h2 class="h2-project teaser-title">{holloway.data.company}</h2>
        <p class="lead teaser-summary">
          I’m the solo contract engineer on Holloway Connect, a live production operations platform.
        </p>

        <ul class="teaser-highlights">
          <li class="body teaser-highlight">
            Grew the test suite from 0 to ~1,400 passing checks, pinning money and payroll math to the penny.
          </li>
        </ul>

        <a class="label-mono experience-link" href="/experience">
          See the experience
          <span class="experience-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </article>
    </Container>
  </section>

  <section class="section works" aria-labelledby="section-work">
    <Container>
      <SectionHeader number="02" title="WORK" id="section-work" count={`${featured.length} / ${allProjects.length}`} />
      <div class="work-list">
        {featured.map((p) => (
          <WorkRow
            number={String(p.data.order).padStart(2, "0")}
            title={p.data.title}
            stack={p.data.techStack.join(" \u00B7 ").toUpperCase()}
            year={p.data.year}
            href={`/projects/${p.id}`}
            tagline={p.data.tagline}
          />
        ))}
        <a class="label-mono see-all-work" href="/projects">
          See all work
          <span class="see-all-arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Container>
  </section>

  <section class="section about" aria-labelledby="section-about">
    <Container>
      <SectionHeader number="03" title="ABOUT" id="section-about" />
      <div class="about-body">
        <p class="about-intro">{ABOUT_INTRO}</p>
        <p class="body">{ABOUT_P1}</p>
        <a class="label-mono read-more" href="/about">READ MORE &rarr;</a>
      </div>
    </Container>
  </section>

  <section class="section contact" aria-labelledby="section-contact">
    <Container>
      <ContactSection showSectionHeader={true} />
    </Container>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { padding-top: 96px; padding-bottom: 0; }
  .hero-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: start; }
  .hero-content { grid-column: 1 / span 8; }
  .hero-meta { grid-column: 9 / span 4; display: flex; flex-direction: column; gap: 8px; }
  .hero-lead { margin-top: 32px; max-width: 40ch; color: var(--ink); }
  .accent-dot { color: var(--accent); }

  /* 01 EXPERIENCE teaser -- compact mirror of experience.astro .featured
     (eyebrow / title / summary / one hairline highlight / deep-link). Stack line
     omitted (D-05). Page-scoped; global.css & BaseLayout.astro untouched (D-19).
     Accent stays on the only clickable affordance -- the deep-link (MASTER §7). */
  .teaser { margin-top: 24px; }
  .teaser-eyebrow { color: var(--ink-muted); margin-bottom: 12px; }
  .teaser-title { color: var(--ink); margin-bottom: 8px; }
  .teaser-summary { color: var(--ink); max-width: 68ch; margin-bottom: 28px; }
  .teaser-highlights { list-style: none; margin: 0 0 24px; padding: 0; max-width: 68ch; }
  .teaser-highlight { color: var(--ink); border-top: 1px solid var(--rule); padding: 16px 0; }

  .experience-link { display: inline-flex; align-items: baseline; gap: 8px; color: var(--ink-muted); text-decoration: none; transition: color 120ms ease; }
  .experience-arrow { color: var(--accent); opacity: 0; transition: opacity 120ms ease; }
  .experience-link:hover, .experience-link:focus-visible { color: var(--accent); }
  .experience-link:hover .experience-arrow, .experience-link:focus-visible .experience-arrow { opacity: 1; }
  .experience-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Reduced motion: keep the accent color change (affordance), drop the arrow
     reveal -- matches the experience.astro .deep-link / .see-all-work contract. */
  @media (prefers-reduced-motion: reduce) {
    .experience-link, .experience-arrow { transition: none; }
    .experience-link:hover .experience-arrow, .experience-link:focus-visible .experience-arrow { opacity: 0; }
  }

  /* About preview */
  .about-body { max-width: 68ch; margin-top: 24px; }
  .about-intro { font-weight: 500; font-size: 1.375rem; line-height: 1.4; color: var(--ink); margin-bottom: 24px; }
  .about-body p:not(.about-intro) { font-weight: 400; font-size: 1.125rem; line-height: 1.6; color: var(--ink); margin-bottom: 16px; }
  .read-more { display: inline-block; margin-top: 24px; color: var(--ink-muted); text-decoration: none; }
  .read-more:hover { color: var(--accent); }

  /* "See all work" -- mirrors the .read-more idiom (label-mono, inline-block,
     24px top, muted -> accent) and adds the experience.astro deep-link arrow
     opacity reveal. Frontend-design routed (SC5). Accent stays on the only
     clickable affordance (MASTER §7). */
  .see-all-work { display: inline-block; margin-top: 24px; color: var(--ink-muted); text-decoration: none; transition: color 120ms ease; }
  .see-all-arrow { color: var(--accent); opacity: 0; transition: opacity 120ms ease; }
  .see-all-work:hover, .see-all-work:focus-visible { color: var(--accent); }
  .see-all-work:hover .see-all-arrow, .see-all-work:focus-visible .see-all-arrow { opacity: 1; }
  .see-all-work:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Reduced motion: keep the accent color change (affordance), drop the arrow
     reveal -- matches the WorkRow / experience.astro deep-link reduce contract. */
  @media (prefers-reduced-motion: reduce) {
    .see-all-work, .see-all-arrow { transition: none; }
    .see-all-work:hover .see-all-arrow, .see-all-work:focus-visible .see-all-arrow { opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .hero { padding-top: 72px; }
    .hero-grid { grid-template-columns: 1fr; }
    .hero-content, .hero-meta { grid-column: auto; }
    .hero-meta { width: 100%; margin-top: 32px; }
  }
  @media (max-width: 767px) {
    .hero { padding-top: 48px; }
  }
</style>
