{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jack-cutrara-portfolio",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "eaa30fef259e4a6b9505b41bbf3f8f01",
      "preview_id": "115f3c1b0f8a4a1da9fee78c48dcb749"
    }
  ],
  // Phase 19 D-01/D-02 — DRY_RUN gate. "1" = dry-run active; "0" = live mail.
  // Phase 20 flipped 2026-05-12 alongside the Resend POST landing (Plan 20-03).
  // Rollback = single-line revert to "1" per D-03 (chat-delivery.ts DRY_RUN
  // branch is the runway; one-line wrangler.jsonc edit + wrangler deploy ~60s).
  // WR-02 — CHAT_REPLY_TO_EMAIL sources the envelope reply_to: field. Optional in DeliveryEnv (logs null if unset).
  "vars": {
    "DRY_RUN": "0",
    "CHAT_REPLY_TO_EMAIL": "jackcutrara@gmail.com"
  },
  "triggers": {
    "crons": ["0 * * * *"] // Phase 19 CRON-01 — hourly cron; flip to ["* * * * *"] for Step 1 UAT then REVERT (Pitfall 6: wrangler-cron-shape.test.ts catches unreverted state)
  },
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
